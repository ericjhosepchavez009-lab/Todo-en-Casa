                            </div>
                            <h3 class="text-xl font-bold text-slate-900 mb-2">Ciclo Común Nocturno</h3>
                            <p class="text-slate-600 text-sm mb-6">Plan acelerado de educación básica para adultos en horario nocturno accesible.</p>
                        </div>
                        <button onclick="openStudyPlan('Ciclo Común Nocturno', 'Jornada Nocturna', ['Español Acelerado', 'Matemáticas Básicas', 'Ciencias Naturales', 'Estudios Sociales', 'Educación Cívica'], 'Módulos Flexibles')" class="w-full bg-fratBlue hover:bg-fratBlueDark text-white font-semibold py-3 rounded-xl text-sm transition-colors flex items-center justify-center space-x-2">
                            <span>Ver Plan de Estudio</span><i class="fas fa-file-alt"></i>
                        </button>
                    </div>
                    <!-- Nocturna Item 2 -->
                    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
                        <div>
                            <img src="imagenes/imagen31.jpg" alt="Bachillerato Nocturno" class="w-full h-44 object-cover rounded-xl mb-4">
                            <div class="flex items-center justify-between mb-4">
                                <span class="bg-indigo-100 text-indigo-800 text-xs font-bold px-3 py-1 rounded-full">Bachillerato</span>
                                <i class="fas fa-user-graduate text-slate-400 text-xl"></i>
                            </div>
