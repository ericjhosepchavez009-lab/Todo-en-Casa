                            <img src="imagenes/imagen23.jpg" alt="Valor Civismo" class="w-full h-32 object-cover rounded-xl mb-3">
                            <div class="w-12 h-12 bg-fratGold text-slate-900 rounded-full mx-auto flex items-center justify-center text-xl font-bold"><i class="fas fa-flag"></i></div>
                            <h4 class="font-bold text-slate-900 text-lg">Civismo</h4>
