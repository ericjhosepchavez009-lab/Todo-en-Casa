            <div>
                <h4 class="font-bold text-base mb-4 text-fratGold">Jornadas</h4>
                <ul class="space-y-2.5 text-sm text-slate-400">
                    <li><a href="#" onclick="switchView('oferta-academica'); filterShift('matutina'); return false;" class="hover:text-white transition-colors">Jornada Matutina</a></li>
                    <li><a href="#" onclick="switchView('oferta-academica'); filterShift('vespertina'); return false;" class="hover:text-white transition-colors">Jornada Vespertina</a></li>
                    <li><a href="#" onclick="switchView('oferta-academica'); filterShift('nocturna'); return false;" class="hover:text-white transition-colors">Jornada Nocturna</a></li>
                    <li><a href="#" onclick="switchView('oferta-academica'); filterShift('isemed'); return false;" class="hover:text-white transition-colors">ISEMED</a></li>
