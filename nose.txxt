                    <li><a href="#" onclick="showHomeView(); return false;" class="hover:text-white transition-colors">Inicio</a></li>
                    <li><a href="#" onclick="switchView('quienes-somos'); return false;" class="hover:text-white transition-colors">Quiénes Somos</a></li>
                    <li><a href="#" onclick="switchView('oferta-academica'); return false;" class="hover:text-white transition-colors">Oferta Académica</a></li>
                    <li><a href="#" onclick="switchView('secretaria'); return false;" class="hover:text-white transition-colors">Secretaría</a></li>
                    <li><a href="#admisiones" onclick="showHomeView(); return false;" class="hover:text-white transition-colors">Admisiones</a></li>
                </ul>
