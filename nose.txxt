        <!-- ==================== SECRETARIA VIEW ==================== -->
        <div id="view-secretaria" class="view-container hidden py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
            <div class="text-center max-w-3xl mx-auto mb-12">
                <span class="text-fratBlue font-bold text-sm tracking-widest uppercase bg-blue-100 px-3 py-1 rounded-full">Gestión Académica y Documental</span>
                <h1 class="text-3xl sm:text-5xl font-black text-slate-900 mt-3">Secretaría General</h1>
                <p class="text-slate-600 mt-3 text-lg">Área encargada del registro académico, emisión de certificaciones, matrícula de estudiantes y trámites oficiales.</p>
            </div>

            <!-- Banner Informativo de Secretaría -->
            <div class="bg-gradient-to-r from-fratBlueDark to-fratBlue text-white p-8 rounded-3xl shadow-lg mb-12 flex flex-col md:flex-row items-center justify-between gap-6">
                <div class="space-y-2">
                    <span class="bg-fratGold text-slate-900 font-bold px-3 py-1 rounded-full text-xs uppercase">Atención al Público</span>
                    <h2 class="text-2xl sm:text-3xl font-extrabold">Trámites y Consultas Académicas</h2>
                    <p class="text-slate-200 text-sm max-w-2xl">Atención presencial en ventanilla de Lunes a Viernes de 7:30 AM a 4:30 PM. Presenta tu documento de identificación para cualquier solicitud.</p>
                </div>
                <div class="flex-shrink-0">
                    <a href="#contacto" onclick="showHomeView(); setTimeout(() => document.getElementById('contacto').scrollIntoView({behavior: 'smooth'}), 100);" class="bg-fratGold hover:bg-amber-500 text-slate-900 font-bold px-6 py-3.5 rounded-xl shadow transition-colors inline-block text-sm">
                        <i class="fas fa-headset mr-2"></i> Contactar Secretaría
                    </a>
                </div>
            </div>

            <!-- Servicios Principales de Secretaría -->
            <div class="grid md:grid-cols-3 gap-8 mb-12">
                <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
                    <div class="w-14 h-14 bg-blue-50 text-fratBlue rounded-2xl flex items-center justify-center text-2xl font-bold mb-6">
                        <i class="fas fa-id-card"></i>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">Matrícula y Registro</h3>
                    <p class="text-slate-600 text-sm leading-relaxed mb-4">Inscripción formal de alumnos de nuevo ingreso y reingreso en todas las modalidades y jornadas educativas.</p>
                    <ul class="text-xs text-slate-500 space-y-1.5 border-t border-slate-100 pt-3">
                        <li class="flex items-center"><i class="fas fa-check text-fratBlue mr-2"></i> Certificado de conducta</li>
                        <li class="flex items-center"><i class="fas fa-check text-fratBlue mr-2"></i> Partida de nacimiento original</li>
                        <li class="flex items-center"><i class="fas fa-check text-fratBlue mr-2"></i> Certificación de estudios previos</li>
                    </ul>
                </div>

                <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
                    <div class="w-14 h-14 bg-amber-50 text-fratGold rounded-2xl flex items-center justify-center text-2xl font-bold mb-6">
                        <i class="fas fa-file-signature"></i>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">Certificaciones de Estudio</h3>
                    <p class="text-slate-600 text-sm leading-relaxed mb-4">Expedición oficial de certificación de calificaciones parciales o finales para trámites universitarios o traslados.</p>
                    <ul class="text-xs text-slate-500 space-y-1.5 border-t border-slate-100 pt-3">
                        <li class="flex items-center"><i class="fas fa-check text-fratGold mr-2"></i> Historial de notas completas</li>
                        <li class="flex items-center"><i class="fas fa-check text-fratGold mr-2"></i> Firma y sello de la Dirección</li>
                        <li class="flex items-center"><i class="fas fa-check text-fratGold mr-2"></i> Entrega en 3 a 5 días hábiles</li>
                    </ul>
                </div>

                <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
                    <div class="w-14 h-14 bg-indigo-50 text-indigo-600 rounded-2xl flex items-center justify-center text-2xl font-bold mb-6">
                        <i class="fas fa-award"></i>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">Títulos y Constancias</h3>
                    <p class="text-slate-600 text-sm leading-relaxed mb-4">Tramitación de títulos de graduación, constancias de egresados, conducta y aprobación de año lectivo.</p>
                    <ul class="text-xs text-slate-500 space-y-1.5 border-t border-slate-100 pt-3">
                        <li class="flex items-center"><i class="fas fa-check text-indigo-600 mr-2"></i> Verificación de expediente</li>
                        <li class="flex items-center"><i class="fas fa-check text-indigo-600 mr-2"></i> Registro ante la Departamental</li>
                        <li class="flex items-center"><i class="fas fa-check text-indigo-600 mr-2"></i> Emisión de autenticaciones</li>
                    </ul>
                </div>
            </div>

            <!-- Requisitos de Trámites Frecuentes -->
            <div class="bg-white p-8 sm:p-12 rounded-3xl shadow-sm border border-slate-200">
                <h3 class="text-2xl font-bold text-slate-900 mb-6 flex items-center">
                    <i class="fas fa-clipboard-list text-fratBlue mr-3"></i> Guía Rápida de Requisitos
                </h3>
                <div class="grid sm:grid-cols-2 gap-6">
                    <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200">
                        <h4 class="font-bold text-slate-900 mb-3 flex items-center"><i class="fas fa-user-plus text-fratBlue mr-2"></i> Traslados e Ingresos Especiales</h4>
                        <p class="text-slate-600 text-sm leading-relaxed">Presentar copia de DNI del encargado, certificación de notas cancelada del instituto de origen y constancia de conducta con firma autenticada.</p>
                    </div>
                    <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200">
                        <h4 class="font-bold text-slate-900 mb-3 flex items-center"><i class="fas fa-certificate text-fratGold mr-2"></i> Duplicado de Certificados o Títulos</h4>
                        <p class="text-slate-600 text-sm leading-relaxed">Solicitud por escrito dirigida a Secretaría, fotocopia de la tarjeta de identidad y recibo de pago correspondiente de la tasa administrativa.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Visor Modal para pantalla completa (Carrusel) -->
        <div id="heroViewer" aria-hidden="true" onclick="heroViewerClick(event)">
            <button class="hero-v-close" onclick="closeHeroViewer()" aria-label="Cerrar"><i class="fas fa-times"></i></button>
            <button class="hero-v-prev" onclick="heroPrev(event)" aria-label="Imagen anterior"><i class="fas fa-chevron-left"></i></button>
            <img id="heroViewerImg" src="" alt="Imagen ampliada">
            <button class="hero-v-next" onclick="heroNext(event)" aria-label="Imagen siguiente"><i class="fas fa-chevron-right"></i></button>
            <div class="hero-v-hint">← → para cambiar · clic izquierdo/derecho sobre la imagen · Esc para cerrar</div>
        </div>
    </main>

