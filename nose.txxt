                    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
                        <div>
                            <img src="imagenes/imagen24.jpg" alt="Ciclo Común" class="w-full h-44 object-cover rounded-xl mb-4">
                            <div class="flex items-center justify-between mb-4">
                                <span class="bg-blue-100 text-fratBlue text-xs font-bold px-3 py-1 rounded-full">Básica</span>
