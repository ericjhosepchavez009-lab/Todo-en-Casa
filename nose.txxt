<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Instituto Departamental La Fraternidad</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome for professional icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        fratBlue: '#1e3a8a',
                        fratBlueDark: '#172554',
                        fratGold: '#f59e0b',
                        fratLight: '#f8fafc',
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        /* Custom scrollbar and modal styling */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        .hero-bg{position:relative;overflow:hidden;background:#0f172a}
        .hero-slide{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity 1s ease}
        .hero-slide.active{opacity:1}
        .hero-overlay{position:absolute;inset:0;background:linear-gradient(rgba(15,23,42,.42),rgba(30,58,138,.58));z-index:1}
    
        .hero-view-btn{position:absolute;right:18px;bottom:18px;z-index:20;width:42px;height:42px;border:1px solid rgba(255,255,255,.28);border-radius:999px;background:rgba(15,23,42,.28);color:#fff;backdrop-filter:blur(8px);opacity:.65;transition:.2s}.hero-view-btn:hover{opacity:1;background:rgba(15,23,42,.55);transform:scale(1.06)}
        #heroViewer{position:fixed;inset:0;z-index:9999;background:rgba(2,6,23,.96);display:none;align-items:center;justify-content:center;padding:30px}#heroViewer.open{display:flex}#heroViewer img{max-width:94vw;max-height:92vh;width:auto;height:auto;object-fit:contain;box-shadow:0 20px 80px rgba(0,0,0,.5);user-select:none}.hero-v-close,.hero-v-prev,.hero-v-next{position:absolute;border:0;color:#fff;background:rgba(255,255,255,.1);backdrop-filter:blur(8px);border-radius:999px;cursor:pointer}.hero-v-close{top:20px;right:20px;width:44px;height:44px;font-size:20px}.hero-v-prev,.hero-v-next{top:50%;transform:translateY(-50%);width:48px;height:48px;font-size:22px}.hero-v-prev{left:20px}.hero-v-next{right:20px}.hero-v-hint{position:absolute;bottom:18px;left:50%;transform:translateX(-50%);color:rgba(255,255,255,.7);font-size:12px;background:rgba(255,255,255,.08);padding:7px 12px;border-radius:999px}
    </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased flex flex-col min-h-screen">
    <!-- Top Contact Bar -->
    <div class="bg-fratBlueDark text-white text-xs sm:text-sm py-2 px-4 shadow-inner">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2">
            <div class="flex items-center space-x-4">
                <span><i class="fas fa-map-marker-alt text-fratGold mr-1.5"></i> Barrio Calona, Juticalpa, Olancho, Honduras</span>
                <span class="hidden md:inline"><i class="fas fa-phone-alt text-fratGold mr-1.5"></i> (504) 2785-0000</span>
            </div>
            <div class="flex items-center space-x-3">
                <span class="bg-fratGold/20 text-fratGold font-semibold px-2.5 py-0.5 rounded-full border border-fratGold/30">Excelencia Académica</span>
                <a href="#contacto" class="hover:text-fratGold transition-colors"><i class="fas fa-envelope mr-1"></i> Contacto</a>
            </div>
        </div>
    </div>

    <!-- Main Header -->
    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md shadow-sm border-b border-slate-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <!-- Brand Logo & Name -->
            <a href="#" onclick="showHomeView(); return false;" class="flex items-center space-x-3 group">
                <img src="imagenes/imagen1.jpg" alt="Logo La Fraternidad" class="w-12 h-12 rounded-xl object-cover shadow-md group-hover:scale-105 transition-transform">
                <div>
                    <h1 class="font-bold text-slate-900 text-base sm:text-lg leading-tight group-hover:text-fratBlue transition-colors">I.D. La Fraternidad</h1>
                    <p class="text-xs text-slate-500 font-medium">Institución educativa líder en Olancho</p>
                </div>
            </a>
            <!-- Desktop Navigation Links -->
            <nav class="hidden lg:flex items-center space-x-1 font-medium text-sm">
                <a href="#" onclick="showHomeView(); return false;" class="nav-link px-3 py-2 rounded-lg text-slate-700 hover:text-fratBlue hover:bg-slate-100 transition-all active-nav" id="link-home">Inicio</a>
                <a href="#conocenos" onclick="showHomeView(); setTimeout(() => document.getElementById('conocenos').scrollIntoView({behavior: 'smooth'}), 100); return false;" class="nav-link px-3 py-2 rounded-lg text-slate-700 hover:text-fratBlue hover:bg-slate-100 transition-all" id="link-conocenos">Conócenos</a>
                <a href="#" onclick="switchView('quienes-somos'); return false;" class="nav-link px-3 py-2 rounded-lg text-slate-700 hover:text-fratBlue hover:bg-slate-100 transition-all" id="link-quienes">Quiénes Somos</a>
                <a href="#" onclick="switchView('oferta-academica'); return false;" class="nav-link px-3 py-2 rounded-lg text-slate-700 hover:text-fratBlue hover:bg-slate-100 transition-all" id="link-oferta">Oferta Académica</a>
                <a href="#" onclick="switchView('secretaria'); return false;" class="nav-link px-3 py-2 rounded-lg text-slate-700 hover:text-fratBlue hover:bg-slate-100 transition-all" id="link-secretaria">Secretaría</a>
                <a href="#admisiones" onclick="showHomeView(); setTimeout(() => document.getElementById('admisiones').scrollIntoView({behavior: 'smooth'}), 100); return false;" class="nav-link px-3 py-2 rounded-lg text-slate-700 hover:text-fratBlue hover:bg-slate-100 transition-all">Admisiones</a>
                <a href="#ubicacion" onclick="showHomeView(); setTimeout(() => document.getElementById('ubicacion').scrollIntoView({behavior: 'smooth'}), 100); return false;" class="nav-link px-3 py-2 rounded-lg text-slate-700 hover:text-fratBlue hover:bg-slate-100 transition-all">Ubicación</a>
                <a href="#contacto" onclick="showHomeView(); setTimeout(() => document.getElementById('contacto').scrollIntoView({behavior: 'smooth'}), 100); return false;" class="ml-2 bg-fratBlue text-white px-4 py-2.5 rounded-xl font-semibold shadow hover:bg-fratBlueDark transition-all">Portal / Contacto</a>
            </nav>
            <!-- Mobile Menu Button -->
            <button onclick="toggleMobileMenu()" class="lg:hidden text-slate-700 hover:text-fratBlue p-2 focus:outline-none">
                <i class="fas fa-bars text-2xl" id="mobile-menu-icon"></i>
            </button>
        </div>
        <!-- Mobile Dropdown Menu -->
        <div id="mobile-menu" class="hidden lg:hidden bg-white border-b border-slate-200 px-4 pt-2 pb-4 space-y-2 shadow-lg">
            <a href="#" onclick="showHomeView(); toggleMobileMenu(); return false;" class="block px-3 py-2 rounded-lg text-slate-700 hover:bg-slate-100 font-medium">Inicio</a>
            <a href="#conocenos" onclick="showHomeView(); toggleMobileMenu(); setTimeout(() => document.getElementById('conocenos').scrollIntoView({behavior: 'smooth'}), 100); return false;" class="block px-3 py-2 rounded-lg text-slate-700 hover:bg-slate-100 font-medium">Conócenos</a>
            <a href="#" onclick="switchView('quienes-somos'); toggleMobileMenu(); return false;" class="block px-3 py-2 rounded-lg text-slate-700 hover:bg-slate-100 font-medium">Quiénes Somos</a>
            <a href="#" onclick="switchView('oferta-academica'); toggleMobileMenu(); return false;" class="block px-3 py-2 rounded-lg text-slate-700 hover:bg-slate-100 font-medium">Oferta Académica</a>
            <a href="#" onclick="switchView('secretaria'); toggleMobileMenu(); return false;" class="block px-3 py-2 rounded-lg text-slate-700 hover:bg-slate-100 font-medium">Secretaría</a>
            <a href="#admisiones" onclick="showHomeView(); toggleMobileMenu(); setTimeout(() => document.getElementById('admisiones').scrollIntoView({behavior: 'smooth'}), 100); return false;" class="block px-3 py-2 rounded-lg text-slate-700 hover:bg-slate-100 font-medium">Admisiones</a>
            <a href="#ubicacion" onclick="showHomeView(); toggleMobileMenu(); setTimeout(() => document.getElementById('ubicacion').scrollIntoView({behavior: 'smooth'}), 100); return false;" class="block px-3 py-2 rounded-lg text-slate-700 hover:bg-slate-100 font-medium">Ubicación</a>
            <a href="#contacto" onclick="showHomeView(); toggleMobileMenu(); setTimeout(() => document.getElementById('contacto').scrollIntoView({behavior: 'smooth'}), 100); return false;" class="block w-full text-center bg-fratBlue text-white px-4 py-2.5 rounded-xl font-semibold shadow">Portal / Contacto</a>
        </div>
    </header>

    <main class="flex-grow">
        <!-- ==================== HOME VIEW ==================== -->
        <div id="view-home" class="view-container">
            <!-- Hero Banner Section -->
            <section class="hero-bg text-white py-24 lg:py-36 px-4 relative flex items-center justify-center">
                <!-- Carrusel de imágenes (imagen2.jpg a imagen6.jpg) -->
                <img class="hero-slide active" src="imagenes/imagen2.jpg" alt="Instituto La Fraternidad - Vista 1">
                <img class="hero-slide" src="imagenes/imagen3.jpg" alt="Instituto La Fraternidad - Vista 2">
                <img class="hero-slide" src="imagenes/imagen4.jpg" alt="Instituto La Fraternidad - Vista 3">
                <img class="hero-slide" src="imagenes/imagen5.jpg" alt="Instituto La Fraternidad - Vista 4">
                <img class="hero-slide" src="imagenes/imagen6.jpg" alt="Instituto La Fraternidad - Vista 5">
                
                <div class="hero-overlay"></div>
                <button class="hero-view-btn" onclick="openHeroViewer()" aria-label="Ver imágenes en pantalla completa" title="Ver imagen completa">
                    <i class="fas fa-expand"></i>
                </button>
                <div class="max-w-5xl mx-auto text-center space-y-6 relative z-10">
                    <span class="inline-block bg-fratGold text-slate-900 font-bold px-4 py-1.5 rounded-full text-xs sm:text-sm tracking-wide uppercase shadow-lg">
                        Orgullo Olanchano • Juticalpa
                    </span>
                    <h1 class="text-4xl sm:text-5xl lg:text-7xl font-extrabold tracking-tight leading-tight">
                        Instituto Departamental <br/><span class="text-fratGold">La Fraternidad</span>
                    </h1>
                    <p class="text-lg sm:text-xl text-slate-200 max-w-3xl mx-auto font-light leading-relaxed">
                        Forjando generaciones con sólida formación académica, valores éticos y excelencia técnica en el corazón de Olancho.
                    </p>
                    <div class="pt-4 flex flex-wrap justify-center gap-4">
                        <button onclick="switchView('oferta-academica')" class="bg-fratGold hover:bg-amber-500 text-slate-900 font-bold px-8 py-4 rounded-xl shadow-xl transition-all transform hover:-translate-y-1 flex items-center space-x-2">
                            <span>Ver Oferta Académica</span>
                            <i class="fas fa-arrow-right"></i>
                        </button>
                        <button onclick="switchView('quienes-somos')" class="bg-white/10 hover:bg-white/25 text-white border border-white/30 backdrop-blur-md font-semibold px-8 py-4 rounded-xl transition-all">
                            Conoce Nuestra Historia
                        </button>
                    </div>
                </div>
            </section>

            <!-- Stats Bar Section -->
            <section id="conocenos" class="bg-white py-12 border-b border-slate-200 shadow-sm relative z-20">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center divide-x-0 md:divide-x divide-slate-100">
                        <div class="p-4">
                            <div class="text-4xl lg:text-5xl font-black text-fratBlue mb-1">50+</div>
                            <div class="text-sm font-semibold text-slate-600 uppercase tracking-wider">Años de trayectoria</div>
                        </div>
                        <div class="p-4">
                            <div class="text-4xl lg:text-5xl font-black text-fratGold mb-1">2,500+</div>
                            <div class="text-sm font-semibold text-slate-600 uppercase tracking-wider">Estudiantes activos</div>
                        </div>
                        <div class="p-4">
                            <div class="text-4xl lg:text-5xl font-black text-fratBlue mb-1">10+</div>
                            <div class="text-sm font-semibold text-slate-600 uppercase tracking-wider">Carreras y ciclos</div>
                        </div>
                        <div class="p-4">
                            <div class="text-4xl lg:text-5xl font-black text-fratGold mb-1">100%</div>
                            <div class="text-sm font-semibold text-slate-600 uppercase tracking-wider">Compromiso social</div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Features / Why Choose Us Section -->
            <section class="py-20 bg-slate-100 px-4 sm:px-6 lg:px-8">
                <div class="max-w-7xl mx-auto">
                    <div class="text-center max-w-3xl mx-auto mb-16">
                        <span class="text-fratBlue font-bold text-sm tracking-widest uppercase bg-blue-100 px-3 py-1 rounded-full">Excelencia integral</span>
                        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 mt-3">¿Por qué elegir La Fraternidad?</h2>
                        <p class="text-slate-600 mt-3 text-base sm:text-lg">Proveemos un ambiente propicio para el desarrollo cognitivo, tecnológico y humano de cada alumno.</p>
                    </div>
                    <div class="grid md:grid-cols-3 gap-8">
                        <div class="bg-white p-8 rounded-2xl shadow-sm hover:shadow-md transition-shadow border border-slate-200">
                            <div class="w-14 h-14 bg-blue-50 text-fratBlue rounded-2xl flex items-center justify-center text-2xl font-bold mb-6">
                                <i class="fas fa-graduation-cap"></i>
                            </div>
                            <h3 class="text-xl font-bold text-slate-900 mb-3">Docentes calificados</h3>
                            <p class="text-slate-600 leading-relaxed">Profesores altamente capacitados con sólida vocación pedagógica comprometidos con el éxito estudiantil.</p>
                        </div>
                        <div class="bg-white p-8 rounded-2xl shadow-sm hover:shadow-md transition-shadow border border-slate-200">
                            <div class="w-14 h-14 bg-amber-50 text-fratGold rounded-2xl flex items-center justify-center text-2xl font-bold mb-6">
                                <i class="fas fa-laptop-code"></i>
                            </div>
                            <h3 class="text-xl font-bold text-slate-900 mb-3">Tecnología y talleres</h3>
                            <p class="text-slate-600 leading-relaxed">Laboratorios de computación equipados y talleres especializados para carreras técnicas de alta demanda laboral.</p>
                        </div>
                        <div class="bg-white p-8 rounded-2xl shadow-sm hover:shadow-md transition-shadow border border-slate-200">
                            <div class="w-14 h-14 bg-blue-50 text-fratBlue rounded-2xl flex items-center justify-center text-2xl font-bold mb-6">
                                <i class="fas fa-users"></i>
                            </div>
                            <h3 class="text-xl font-bold text-slate-900 mb-3">Ambiente fraterno</h3>
                            <p class="text-slate-600 leading-relaxed">Fomentamos la fraternidad, el respeto mutuo, el liderazgo juvenil y el deporte en toda la comunidad.</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Galería Destacada -->
            <section class="py-16 bg-white px-4 sm:px-6 lg:px-8 border-t border-slate-200">
                <div class="max-w-7xl mx-auto">
                    <div class="text-center max-w-3xl mx-auto mb-12">
                        <span class="text-fratBlue font-bold text-sm tracking-widest uppercase bg-blue-100 px-3 py-1 rounded-full">Nuestras Instalaciones</span>
                        <h2 class="text-3xl font-black text-slate-900 mt-3">Galería Institucional</h2>
                    </div>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                        <img src="imagenes/imagen7.jpg" alt="Instalaciones 1" class="rounded-xl shadow object-cover h-48 w-full hover:scale-105 transition-transform">
                        <img src="imagenes/imagen8.jpg" alt="Instalaciones 2" class="rounded-xl shadow object-cover h-48 w-full hover:scale-105 transition-transform">
                        <img src="imagenes/imagen9.jpg" alt="Instalaciones 3" class="rounded-xl shadow object-cover h-48 w-full hover:scale-105 transition-transform">
                        <img src="imagenes/imagen10.jpg" alt="Instalaciones 4" class="rounded-xl shadow object-cover h-48 w-full hover:scale-105 transition-transform">
                    </div>
                </div>
            </section>

            <!-- Preview of Offerings Section -->
            <section class="py-20 bg-slate-50 px-4 sm:px-6 lg:px-8">
                <div class="max-w-7xl mx-auto">
                    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
                        <div>
                            <span class="text-fratBlue font-bold text-sm tracking-widest uppercase">Oferta educativa</span>
                            <h2 class="text-3xl sm:text-4xl font-black text-slate-900 mt-2">Jornadas y modalidades</h2>
                        </div>
                        <button onclick="switchView('oferta-academica')" class="mt-4 md:mt-0 text-fratBlue font-bold hover:text-fratBlueDark flex items-center space-x-2">
                            <span>Ver todas las jornadas detalladas</span>
                            <i class="fas fa-arrow-right"></i>
                        </button>
                    </div>
                    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
                        <div class="bg-white border border-slate-200 rounded-2xl p-6 hover:border-fratBlue transition-all flex flex-col justify-between shadow-sm">
                            <div>
                                <img src="imagenes/imagen11.jpg" alt="Jornada Matutina" class="w-full h-40 object-cover rounded-xl mb-4">
                                <div class="inline-block bg-blue-100 text-fratBlue font-bold text-xs px-3 py-1 rounded-full mb-2">Matutina</div>
                                <h3 class="text-xl font-bold text-slate-900 mb-2">Jornada Matutina</h3>
                                <p class="text-slate-600 text-sm mb-6">Ciclo Común y bachilleratos técnicos y científicos en horario diurno regular.</p>
                            </div>
                            <button onclick="switchView('oferta-academica'); filterShift('matutina');" class="w-full bg-fratBlue text-white font-semibold py-2.5 rounded-xl text-sm hover:bg-fratBlueDark transition-colors">
                                Ver Carreras Matutinas
                            </button>
                        </div>
                        <div class="bg-white border border-slate-200 rounded-2xl p-6 hover:border-fratBlue transition-all flex flex-col justify-between shadow-sm">
                            <div>
                                <img src="imagenes/imagen12.jpg" alt="Jornada Vespertina" class="w-full h-40 object-cover rounded-xl mb-4">
                                <div class="inline-block bg-amber-100 text-amber-800 font-bold text-xs px-3 py-1 rounded-full mb-2">Vespertina</div>
                                <h3 class="text-xl font-bold text-slate-900 mb-2">Jornada Vespertina</h3>
                                <p class="text-slate-600 text-sm mb-6">Bachilleratos Técnicos Profesionales enfocados en comercio y servicios por la tarde.</p>
                            </div>
                            <button onclick="switchView('oferta-academica'); filterShift('vespertina');" class="w-full bg-fratBlue text-white font-semibold py-2.5 rounded-xl text-sm hover:bg-fratBlueDark transition-colors">
                                Ver Carreras Vespertinas
                            </button>
                        </div>
                        <div class="bg-white border border-slate-200 rounded-2xl p-6 hover:border-fratBlue transition-all flex flex-col justify-between shadow-sm">
                            <div>
                                <img src="imagenes/imagen13.jpg" alt="Nocturna e ISEMED" class="w-full h-40 object-cover rounded-xl mb-4">
                                <div class="inline-block bg-indigo-100 text-indigo-800 font-bold text-xs px-3 py-1 rounded-full mb-2">Nocturna / ISEMED</div>
                                <h3 class="text-xl font-bold text-slate-900 mb-2">Nocturna & ISEMED</h3>
                                <p class="text-slate-600 text-sm mb-6">Educación flexible para jóvenes y adultos que trabajan y desean superarse.</p>
                            </div>
                            <button onclick="switchView('oferta-academica'); filterShift('nocturna');" class="w-full bg-fratBlue text-white font-semibold py-2.5 rounded-xl text-sm hover:bg-fratBlueDark transition-colors">
                                Ver Programas Especiales
                            </button>
                        </div>
                    </div>
                </div>
            </section>

            <!-- History Summary on Homepage -->
            <section class="py-20 bg-slate-900 text-white px-4 sm:px-6 lg:px-8">
                <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-12 items-center">
                    <div class="space-y-6">
                        <span class="text-fratGold font-bold text-sm tracking-widest uppercase">Legado de honor</span>
                        <h2 class="text-3xl sm:text-4xl font-extrabold">Una institución pilar en la sociedad olanchana</h2>
                        <p class="text-slate-300 leading-relaxed">
                            Fundado con la firme convicción de expandir el conocimiento y transformar vidas, el Instituto Departamental La Fraternidad ha formado a miles de profesionales que hoy lideran en Olancho y en toda Honduras.
                        </p>
                        <div class="pt-2">
                            <button onclick="switchView('quienes-somos')" class="bg-fratGold hover:bg-amber-500 text-slate-900 font-bold px-6 py-3 rounded-xl shadow transition-colors">
                                Leer Historia Completa
                            </button>
                        </div>
                    </div>
                    <div class="relative">
                        <div class="bg-slate-800 border border-slate-700 p-8 rounded-3xl shadow-2xl relative z-10 space-y-6 overflow-hidden">
                            <img src="imagenes/imagen14.jpg" alt="Historia La Fraternidad" class="w-full h-48 object-cover rounded-xl mb-4">
                            <div class="flex items-center space-x-4">
                                <div class="w-12 h-12 rounded-full bg-fratGold text-slate-900 flex items-center justify-center font-bold text-xl">
                                    <i class="fas fa-landmark"></i>
                                </div>
                                <div>
                                    <h4 class="font-bold text-lg">Tradición y futuro</h4>
                                    <p class="text-slate-400 text-xs">Juticalpa, Olancho</p>
                                </div>
                            </div>
                            <p class="text-slate-300 text-sm italic">
                                "La fraternidad no es solo un nombre, es el lazo inquebrantable de hermandad, superación y civismo que une a cada estudiante bajo nuestro estandarte."
                            </p>
                        </div>
                        <div class="absolute -bottom-6 -right-6 w-72 h-72 bg-fratBlue/30 rounded-full blur-3xl pointer-events-none"></div>
                    </div>
                </div>
            </section>

            <!-- Admissions Section -->
            <section id="admisiones" class="py-20 bg-white px-4 sm:px-6 lg:px-8">
                <div class="max-w-7xl mx-auto">
                    <div class="bg-gradient-to-br from-fratBlue to-fratBlueDark text-white rounded-3xl p-8 sm:p-12 shadow-xl relative overflow-hidden">
                        <div class="relative z-10 max-w-2xl space-y-6">
                            <span class="bg-fratGold text-slate-900 font-bold px-3.5 py-1 rounded-full text-xs uppercase">Proceso abierto</span>
