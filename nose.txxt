                            </div>
                            <h3 class="text-xl font-bold text-slate-900 mb-2">BTP en Contaduría y Finanzas</h3>
                            <p class="text-slate-600 text-sm mb-6">Gestión contable, auditoría básica, finanzas corporativas y manejo de software contable moderno.</p>
                        </div>
                        <button onclick="openStudyPlan('BTP en Contaduría y Finanzas', 'Jornada Vespertina', ['Contabilidad General I y II', 'Matemáticas Financieras', 'Legislación Tributaria', 'Auditoría', 'Práctica Profesional'], '3 Años')" class="w-full bg-fratBlue hover:bg-fratBlueDark text-white font-semibold py-3 rounded-xl text-sm transition-colors flex items-center justify-center space-x-2">
                            <span>Ver Plan de Estudio</span><i class="fas fa-file-alt"></i>
                        </button>
                    </div>
                    <!-- Vespertina Item 2 -->
                    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
                        <div>
                            <img src="imagenes/imagen29.jpg" alt="Administración de Empresas" class="w-full h-44 object-cover rounded-xl mb-4">
