            <div class="flex flex-wrap justify-center gap-2 mb-12">
                <button onclick="switchQuienesTab('historia')" id="btn-tab-historia" class="quienes-tab-btn px-6 py-3 rounded-xl font-bold text-sm transition-all bg-fratBlue text-white shadow">
                    <i class="fas fa-book-open mr-2"></i> Historia
                </button>
                <button onclick="switchQuienesTab('mision-vision')" id="btn-tab-mision-vision" class="quienes-tab-btn px-6 py-3 rounded-xl font-bold text-sm transition-all bg-white text-slate-700 hover:bg-slate-100 border border-slate-200">
                    <i class="fas fa-bullseye mr-2"></i> Misión y visión
                </button>
                <button onclick="switchQuienesTab('filosofia')" id="btn-tab-filosofia" class="quienes-tab-btn px-6 py-3 rounded-xl font-bold text-sm transition-all bg-white text-slate-700 hover:bg-slate-100 border border-slate-200">
