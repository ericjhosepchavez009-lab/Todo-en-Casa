    <!-- Study Plan Modal -->
    <div id="study-plan-modal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden items-center justify-center p-4">
        <div class="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-2xl relative transform transition-all scale-95 opacity-0" id="modal-content-box">
            <button onclick="closeStudyPlan()" class="absolute top-5 right-5 text-slate-400 hover:text-slate-700 w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center transition-colors">
                <i class="fas fa-times text-lg"></i>
            </button>
            <span id="modal-shift" class="text-xs font-bold uppercase tracking-wider bg-blue-100 text-fratBlue px-3 py-1 rounded-full">Jornada</span>
            <h3 id="modal-title" class="text-2xl font-black text-slate-900 mt-3 mb-1">Nombre de la Carrera</h3>
            <p id="modal-duration" class="text-sm font-semibold text-slate-500 mb-6">Duración: 3 Años</p>
            <div class="space-y-3">
                <h4 class="text-sm font-bold text-slate-700 uppercase tracking-wider">Asignaturas Principales del Plan de Estudio:</h4>
                <ul id="modal-subjects" class="space-y-2 bg-slate-50 p-4 rounded-2xl border border-slate-200 max-h-60 overflow-y-auto text-sm text-slate-700">
                    <!-- Dinámico -->
                </ul>
            </div>
            <div class="mt-8">
                <button onclick="closeStudyPlan()" class="w-full bg-fratBlue text-white font-bold py-3 rounded-xl hover:bg-fratBlueDark transition-colors">
                    Cerrar Plan de Estudio
                </button>
            </div>
        </div>
    </div>

    <!-- JavaScript Logic -->
    <script>
        // Cambiar entre vistas principales (Inicio, Quiénes Somos, Oferta Académica, Secretaría)
        function switchView(viewName) {
            const views = document.querySelectorAll('.view-container');
            views.forEach(v => v.classList.add('hidden'));
            const targetView = document.getElementById('view-' + viewName);
            if (targetView) {
                targetView.classList.remove('hidden');
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
            document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('text-fratBlue', 'bg-slate-100'));
            if (viewName === 'quienes-somos') {
                const el = document.getElementById('link-quienes');
                if (el) el.classList.add('text-fratBlue', 'bg-slate-100');
            } else if (viewName === 'oferta-academica') {
                const el = document.getElementById('link-oferta');
                if (el) el.classList.add('text-fratBlue', 'bg-slate-100');
            } else if (viewName === 'secretaria') {
                const el = document.getElementById('link-secretaria');
                if (el) el.classList.add('text-fratBlue', 'bg-slate-100');
            }
        }

        function showHomeView() {
            const views = document.querySelectorAll('.view-container');
            views.forEach(v => v.classList.add('hidden'));
            document.getElementById('view-home').classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
            document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('text-fratBlue', 'bg-slate-100'));
            document.getElementById('link-home').classList.add('text-fratBlue', 'bg-slate-100');
        }

        // Toggle menú móvil
        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            const icon = document.getElementById('mobile-menu-icon');
            menu.classList.toggle('hidden');
            if (menu.classList.contains('hidden')) {
                icon.className = 'fas fa-bars text-2xl';
            } else {
                icon.className = 'fas fa-times text-2xl';
            }
        }

        // Pestañas de Quiénes Somos
        function switchQuienesTab(tabName) {
            document.querySelectorAll('.quienes-content').forEach(c => c.classList.add('hidden'));
            document.querySelectorAll('.quienes-tab-btn').forEach(b => {
                b.className = 'quienes-tab-btn px-6 py-3 rounded-xl font-bold text-sm transition-all bg-white text-slate-700 hover:bg-slate-100 border border-slate-200';
            });
            document.getElementById('content-tab-' + tabName).classList.remove('hidden');
            const btn = document.getElementById('btn-tab-' + tabName);
            btn.className = 'quienes-tab-btn px-6 py-3 rounded-xl font-bold text-sm transition-all bg-fratBlue text-white shadow';
        }

        // Filtro de Jornadas en Oferta Académica
        function filterShift(shiftName) {
            document.querySelectorAll('.shift-pane').forEach(p => p.classList.add('hidden'));
            document.querySelectorAll('.shift-tab-btn').forEach(b => {
                b.className = 'shift-tab-btn px-5 py-3 rounded-xl font-bold text-sm transition-all bg-white text-slate-700 hover:bg-slate-100 border border-slate-200';
            });
            const pane = document.getElementById('shift-content-' + shiftName);
            if (pane) pane.classList.remove('hidden');
            const btn = document.getElementById('shift-btn-' + shiftName);
            if (btn) btn.className = 'shift-tab-btn px-5 py-3 rounded-xl font-bold text-sm transition-all bg-fratBlue text-white shadow';
        }

        // Modal de Plan de Estudios
        function openStudyPlan(careerName, shiftName, subjects, duration) {
            document.getElementById('modal-title').innerText = careerName;
            document.getElementById('modal-shift').innerText = shiftName;
            document.getElementById('modal-duration').innerText = 'Duración / Modalidad: ' + duration;
            const listEl = document.getElementById('modal-subjects');
            listEl.innerHTML = '';
            subjects.forEach(sub => {
                const li = document.createElement('li');
                li.className = 'flex items-center space-x-2';
                li.innerHTML = '<i class="fas fa-check-circle text-fratBlue"></i><span>' + sub + '</span>';
                listEl.appendChild(li);
            });
            const modal = document.getElementById('study-plan-modal');
            const box = document.getElementById('modal-content-box');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            setTimeout(() => {
                box.classList.remove('scale-95', 'opacity-0');
                box.classList.add('scale-100', 'opacity-100');
            }, 10);
        }

        function closeStudyPlan() {
            const modal = document.getElementById('study-plan-modal');
            const box = document.getElementById('modal-content-box');
            box.classList.remove('scale-100', 'opacity-100');
            box.classList.add('scale-95', 'opacity-0');
            setTimeout(() => {
                modal.classList.remove('flex');
                modal.classList.add('hidden');
            }, 200);
        }

        // Carrusel del Hero y Visor
        const heroSlides = [...document.querySelectorAll('.hero-slide')];
        let heroIndex = 0;
        const heroViewer = document.getElementById('heroViewer');
        const heroViewerImg = document.getElementById('heroViewerImg');

        function setHero(i) {
            heroIndex = (i + heroSlides.length) % heroSlides.length;
            heroSlides.forEach((s, n) => s.classList.toggle('active', n === heroIndex));
            if (heroViewer.classList.contains('open')) heroViewerImg.src = heroSlides[heroIndex].src;
        }

        setInterval(() => setHero(heroIndex + 1), 5000);

        function openHeroViewer() {
            heroViewerImg.src = heroSlides[heroIndex].src;
            heroViewer.classList.add('open');
            heroViewer.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
        }

        function closeHeroViewer() {
            heroViewer.classList.remove('open');
            heroViewer.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
        }

        function heroPrev(e) {
            e.stopPropagation();
            setHero(heroIndex - 1);
        }

        function heroNext(e) {
            e.stopPropagation();
            setHero(heroIndex + 1);
        }

        function heroViewerClick(e) {
            if (e.target !== heroViewerImg && e.target === heroViewer) return closeHeroViewer();
            if (e.target === heroViewerImg) {
                if (e.button === 2) return heroPrev(e);
                if (e.button === 0) return e.clientX < innerWidth / 2 ? heroPrev(e) : heroNext(e);
            }
        }

        heroViewer.addEventListener('contextmenu', e => {
            if (e.target === heroViewerImg) {
                e.preventDefault();
                heroPrev(e);
            }
        });

        document.addEventListener('keydown', e => {
            if (!heroViewer.classList.contains('open')) return;
            if (e.key === 'Escape') closeHeroViewer();
            if (e.key === 'ArrowLeft') heroPrev(e);
            if (e.key === 'ArrowRight') heroNext(e);
        });
    </script>
</body>
</html>