                            <div class="flex items-center justify-between mb-4">
                                <span class="bg-blue-100 text-fratBlue text-xs font-bold px-3 py-1 rounded-full">Científico</span>
                                <i class="fas fa-flask text-slate-400 text-xl"></i>
                            </div>
